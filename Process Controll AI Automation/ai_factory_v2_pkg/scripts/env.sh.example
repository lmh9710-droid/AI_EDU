# ===== 현장 설정: 모든 실행 스크립트가 공통으로 읽습니다 =====
# 이 파일(env.sh.example)을 env.sh 로 복사해서 수정하세요. install.sh 가 env.sh 가 없을 때만 자동 복사합니다.
# env.sh 는 현장 고유 설정이라 업데이트(install.sh)가 절대 덮어쓰지 않습니다.
# 포트는 재부팅·재연결 시 번호가 바뀌지 않도록 by-id 경로를 쓰세요.
#   ls -l /dev/serial/by-id/   로 확인 후 각 설비에 맞게 수정
export SF_PORT_FORGING=/dev/serial/by-id/usb-Arduino_UNO_R4_Minima_XXXXXXXX-if00     # 1호기 압조
export SF_PORT_ROLLING=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0               # 2호기 전조 (CH340)
export SF_PORT_HEAT=/dev/serial/by-id/usb-Arduino_UNO_R4_Minima_YYYYYYYY-if00        # 3호기 열처리
export SF_PORT_CONVEYOR=/dev/serial/by-id/usb-Arduino_UNO_R4_Minima_ZZZZZZZZ-if00    # 4호기 컨베이어 (Rust 허브 전용)

export SF_DB_PATH="$HOME/ai_factory/data/smart_factory_v2.db"
export SF_HUB_SOCK=/tmp/sf_interlock.sock
export SF_STORE_RAW=0        # 1 이면 1호기 원시 진동 파형(초당 4KB)도 DB 에 저장
